# Als .env kopieren und ausfüllen (nicht ins Git). Die beiden Secrets setzt ihr mit:
#   firebase functions:secrets:set REVENUECAT_SECRET_KEY
#   firebase functions:secrets:set REVENUECAT_WEBHOOK_SECRET
REVENUECAT_PROJECT_ID=proj1ab2c3d4
# Tuya Cloud (Server-Überwachung): Rechenzentrum, z. B. https://openapi.tuyaeu.com (EU), https://openapi.tuyaus.com (USA)
# Secrets: firebase functions:secrets:set TUYA_CLIENT_ID und TUYA_CLIENT_SECRET
TUYA_BASE_URL=https://openapi.tuyaeu.com
