rules_version = '2';

// Die App liest nur. Alles Schreiben läuft über die Cloud Functions, die Grenzen und Rechte prüfen.
// Einzige Ausnahme: Messwerte für den Verlauf der eigenen Boxen (history), mit festem Format.
service cloud.firestore {
  match /databases/{database}/documents {

    // Angemeldet mit bestätigter E-Mail-Adresse
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isStaff(clubId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.staffUids;
    }

    // Moderatoren: aktive Mitglieder mit Moderations-Werkzeugen, ohne Team-Platz (Liste pflegen nur die Functions)
    function isModerator(clubId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.get('moderatorUids', []);
    }

    function isActiveMember(clubId) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.clubId == clubId
        && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.status == 'active';
    }

    // Eigene Club-Zugehörigkeit
    match /memberships/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /clubs/{clubId} {
      // Club-Daten inkl. Mitglieder-Code: nur das Team
      allow read: if signedIn() && request.auth.uid in resource.data.staffUids;

      // Mitgliederliste: das Team; jedes Mitglied sieht nur sich selbst
      match /members/{memberUid} {
        allow read: if isStaff(clubId) || (signedIn() && request.auth.uid == memberUid);
      }

      // Reservierungen: das Team; Mitglieder nur ihre eigenen
      match /reservations/{reservationId} {
        allow read: if isStaff(clubId) || (signedIn() && resource.data.memberUid == request.auth.uid);
      }

      // Gemeinsame Club-Boxen: jedes aktive Mitglied und das Team liest; die Konfiguration schreiben die
      // Functions, die letzten Messwerte (latest) nur der Betreuer, im festen Format
      match /growBoxes/{boxId} {
        allow read: if isStaff(clubId) || isActiveMember(clubId);
        allow update: if signedIn()
          && request.auth.uid == resource.data.keeperUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latest'])
          && request.resource.data.latest.keys().hasOnly(['at', 'online', 'values'])
          && request.resource.data.latest.at is timestamp
          && request.resource.data.latest.online is bool
          && request.resource.data.latest.values is map
          && request.resource.data.latest.values.size() <= 12;
      }

      // Marktplatz: aktive Mitglieder und das Team lesen; geschrieben wird nur über die Functions
      match /listings/{listingId} {
        allow read: if isStaff(clubId) || isActiveMember(clubId);

        // Interesse: der Anbieter, wer Interesse gemeldet hat, und das Team
        match /interests/{interestUid} {
          allow read: if isStaff(clubId)
            || (signedIn() && (request.auth.uid == interestUid || request.auth.uid == resource.data.sellerUid));
        }

        match /reports/{reportUid} {
          allow read: if isStaff(clubId) || isModerator(clubId);
        }
      }

      match /propagationRequests/{requestId} {
        allow read: if isStaff(clubId) || (signedIn() && resource.data.memberUid == request.auth.uid);
      }

      match /propagationLog/{entryId} {
        allow read: if isStaff(clubId);
      }

      // Ankündigungen von Team und Moderation: jedes aktive Mitglied
      match /announcements/{announcementId} {
        allow read: if isStaff(clubId) || isActiveMember(clubId);
      }

      // Moderations-Protokoll: Team und Moderatoren; jede Person sieht die Einträge über sich (mit Grund)
      match /modLog/{entryId} {
        allow read: if isStaff(clubId) || isModerator(clubId)
          || (signedIn() && resource.data.targetUid == request.auth.uid);
      }

      // Abgabe-Dokumentation nach § 26 KCanG: nur das Team
      match /dispensations/{dispensationId} {
        allow read: if isStaff(clubId);
      }
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Push-Token für Alarme: jeder Nutzer verwaltet nur seine eigenen
    match /users/{uid}/pushTokens/{token} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
        && token.size() < 400;
    }

    // Zustand der Server-Überwachung: die App liest nur, ob der Server gerade überwacht
    match /users/{uid}/serverState/{docId} {
      allow read: if isUser(uid);
    }

    // Coins: nur lesen; gebucht wird ausschließlich in den Functions
    match /wallets/{uid} {
      allow read: if isUser(uid);
      match /ledger/{entryId} {
        allow read: if isUser(uid);
      }
    }

    // Eigene Grow-Boxen; geschrieben wird über saveGrowBox und deleteGrowBox, die die Limits prüfen
    match /users/{uid}/growBoxes/{boxId} {
      allow read: if isUser(uid);

      // Messwerte eines UTC-Tages: schreibt die App (Hintergrund-Job), die Löschfrist setzt nur die Function
      match /history/{day} {
        allow read: if isUser(uid);
        allow create: if isUser(uid)
          && validHistory(day)
          && !('expireAt' in request.resource.data)
          && exists(/databases/$(database)/documents/users/$(uid)/growBoxes/$(boxId));
        allow update: if isUser(uid)
          && validHistory(day)
          && request.resource.data.get('expireAt', null) == resource.data.get('expireAt', null);
      }

      // Pflanzen einer Box: der Nutzer schreibt selbst, in festem Format
      match /plants/{plantId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && validPlant(request.resource.data)
          && exists(/databases/$(database)/documents/users/$(uid)/growBoxes/$(boxId));
      }

      // Grow-Tagebuch: der Nutzer schreibt selbst, in festem Format
      match /journal/{entryId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && validJournal(request.resource.data)
          && exists(/databases/$(database)/documents/users/$(uid)/growBoxes/$(boxId));
      }

      // Lichtmessungen: der Nutzer schreibt selbst. Lampen: Tageslicht und Glühbirne für alle, sonst nur die
      // Lampen, die saveLightSetup (prüft die Stufe) für diese Box gespeichert hat, oder mit Premium-Stufe
      match /lightReadings/{readingId} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid)
          && validLightReading(request.resource.data)
          && exists(/databases/$(database)/documents/users/$(uid)/growBoxes/$(boxId))
          && lampsAllowed(uid, boxId, request.resource.data.lampIds);
      }

      // Tagesstatistik für lange Zeiträume, schreibt nur die nächtliche Function
      match /stats/{year} {
        allow read: if isUser(uid);
      }
    }

    // Automationen: Regeln schreiben saveAutomation/deleteAutomation; die App trägt nur das Ergebnis der
    // Übertragung in die Tuya-Cloud ein
    match /users/{uid}/automations/{automationId} {
      allow read: if isUser(uid);
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sceneIds', 'syncError', 'syncedAt'])
        && request.resource.data.sceneIds is list
        && request.resource.data.sceneIds.size() <= 4;
    }

    function optionalNumber(data, field, min, max) {
      return !(field in data) || data[field] == null
        || ((data[field] is number) && data[field] >= min && data[field] <= max);
    }

    function optionalDate(data, field) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function optionalText(data, field, max) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= max);
    }

    function validPlant(data) {
      return data.keys().hasOnly(['name', 'strain', 'origin', 'autoflower', 'startedAt', 'floweringAt', 'harvestedAt',
          'yieldDryG', 'notes', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && optionalText(data, 'strain', 60)
        && (!('origin' in data) || data.origin == null || data.origin in ['seed', 'clone'])
        && (!('autoflower' in data) || data.autoflower is bool)
        && optionalDate(data, 'startedAt')
        && optionalDate(data, 'floweringAt')
        && optionalDate(data, 'harvestedAt')
        && optionalNumber(data, 'yieldDryG', 0, 5000)
        && optionalText(data, 'notes', 500);
    }

    function validJournal(data) {
      return data.keys().hasOnly(['date', 'watered', 'waterMl', 'nutrientsMl', 'values', 'notes', 'plantId', 'createdAt', 'updatedAt'])
        && optionalText(data, 'plantId', 128)
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.watered is bool
        && optionalNumber(data, 'waterMl', 0, 100000)
        && optionalNumber(data, 'nutrientsMl', 0, 10000)
        && (!('values' in data) || (data.values is map && data.values.size() <= 11))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2000));
    }

    function validLightReading(d) {
      return d.keys().hasOnly(['createdAt', 'source', 'lux', 'ppfd', 'dli', 'hours', 'points', 'minPpfd', 'maxPpfd', 'lampIds', 'phase'])
        && d.createdAt == request.time
        && d.source in ['phone', 'tuya', 'manual_lux', 'manual_ppfd']
        && d.ppfd is number && d.ppfd >= 0 && d.ppfd <= 5000
        && optionalNumber(d, 'lux', 0, 300000)
        && optionalNumber(d, 'dli', 0, 200)
        && optionalNumber(d, 'hours', 0, 24)
        && optionalNumber(d, 'minPpfd', 0, 5000)
        && optionalNumber(d, 'maxPpfd', 0, 5000)
        && d.points is int && d.points >= 1 && d.points <= 25
        && d.lampIds is list && d.lampIds.size() >= 1 && d.lampIds.size() <= 6
        && (!('phase' in d) || d.phase == null || (d.phase is string && d.phase.size() <= 20));
    }

    function lampsAllowed(uid, boxId, ids) {
      return ids.hasOnly(['daylight', 'incandescent'])
        || ids.hasOnly(get(/databases/$(database)/documents/users/$(uid)/growBoxes/$(boxId)).data.get('light', {}).get('lampIds', []))
        || get(/databases/$(database)/documents/users/$(uid)).data.get('tierCache', {}).get('tier', 'freemium') in ['premium', 'social_club'];
    }

    function validHistory(day) {
      let d = request.resource.data;
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['day', 's', 'expireAt'])
        && d.day == day
        && d.s is map
        && d.s.size() <= 288;
    }

    // invites, tuyaAccounts und alles andere: kein Zugriff aus der App
  }
}
